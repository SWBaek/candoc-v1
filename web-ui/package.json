{
  "name": "candoc-review-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node server/main.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:codex": "node scripts/check-codex.mjs",
    "test:agent-protocol": "node scripts/check-project-agent-protocol.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
